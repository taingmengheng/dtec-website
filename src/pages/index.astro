---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import StatsBar from '../components/StatsBar.astro';
import heroBackground from '../assets/hero-background.png';
import logo from '../assets/logo.jpg';

const products = [
  { title: "Overhead Cranes", desc: "Single / Double Girder Cranes\nCustom design & installation", icon: "⛓", thumbText: "Overhead Crane" },
  { title: "Gantry Cranes", desc: "Portable & Rail Mounted\nGantry Cranes", icon: "🏗", thumbText: "Gantry Crane" },
  { title: "Cargo Lifts", desc: "Safe & reliable lifts for\nindustrial applications", icon: "📦", thumbText: "Cargo Lift" },
  { title: "Press Brakes", desc: "High precision press brake\nmachines", icon: "🛠", thumbText: "Press Brake" },
  { title: "Decoiler Machines", desc: "Motorized decoiler for\ncoil handling", icon: "🌀", thumbText: "Decoiler Machine" },
  { title: "CNC Fiber Laser", desc: "Steel cutting service with\nCNC Fiber Laser", icon: "✂", thumbText: "CNC Fiber Laser" },
  { title: "BMU Services", desc: "Building Maintenance Unit\nInstallation & Service", icon: "🏢", thumbText: "BMU Services" },
  { title: "Dock Leveler", desc: "Hydraulic dock leveler for\nloading & unloading safety", icon: "🚛", thumbText: "Dock Leveler" },
  { title: "Freezer Room Service", desc: "Installation & service\nup to 15kW", icon: "❄", thumbText: "Freezer Room" },
  { title: "Control & Electrical", desc: "Electrical panel, VFD, Control\nsystem & Safety circuit", icon: "⚡", thumbText: "Control Panel" }
];

const industries = [
  { icon: "🏭", label: "Manufacturing" },
  { icon: "🔩", label: "Steel Fabrication" },
  { icon: "🏗", label: "Construction" },
  { icon: "🏬", label: "Warehouse & Logistics" },
  { icon: "🍾", label: "Food & Beverage" },
  { icon: "⋯", label: "And More" }
];
---

<Layout title="D.TEC | Engineering Machinery Services">
  <!-- HEADER -->
  <header class="flex flex-wrap items-center justify-between gap-3 px-4 py-3.5 bg-white shadow-sm relative z-20 sm:px-6 lg:px-10">
    <div class="flex items-center gap-3">
      <img src={logo.src} alt="D.TEC logo" class="w-36 h-12 object-contain object-left sm:w-48 sm:h-14" />
    </div>

    <nav class="hidden lg:block">
      <ul class="flex items-center gap-7 text-sm font-semibold text-[#2b3b4d]">
        <li><a href="#" class="text-[#e8720c] border-b-2 border-[#e8720c] pb-1">Home</a></li>
        <li><a href="#about" class="hover:text-[#e8720c]">About Us</a></li>
        <li><a href="#products" class="hover:text-[#e8720c]">Products</a></li>
        <li><a href="#services" class="hover:text-[#e8720c]">Services</a></li>
        <li><a href="#" class="hover:text-[#e8720c]">Projects</a></li>
        <li><a href="#" class="hover:text-[#e8720c]">News</a></li>
        <li><a href="#contact" class="hover:text-[#e8720c]">Contact</a></li>
      </ul>
    </nav>

    <nav class="hidden items-center md:flex lg:hidden">
      <ul class="flex items-center gap-4 text-xs font-semibold text-[#2b3b4d] sm:gap-6 sm:text-sm">
        <li><a href="#" class="text-[#e8720c]">Home</a></li>
        <li><a href="#about" class="hover:text-[#e8720c]">About</a></li>
        <li><a href="#products" class="hover:text-[#e8720c]">Products</a></li>
        <li><a href="#services" class="hover:text-[#e8720c]">Services</a></li>
        <li><a href="#contact" class="hover:text-[#e8720c]">Contact</a></li>
      </ul>
    </nav>

    <a href="#contact" class="hidden bg-[#e8720c] hover:bg-[#c85f08] text-white px-3 py-2.5 font-bold text-xs rounded-xs transition md:inline-block sm:px-5 sm:py-3 sm:text-sm">
      Get a Quote &rarr;
    </a>

    <button
      type="button"
      id="mobile-menu-button"
      class="flex h-10 w-10 items-center justify-center border border-[#0d2a52] text-xl font-bold text-[#0d2a52] md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
    >
      &#9776;
    </button>

    <nav id="mobile-menu" class="hidden basis-full border-t border-[#e6e9ed] pt-3 md:hidden">
      <ul class="flex flex-col gap-3 text-sm font-semibold text-[#2b3b4d]">
        <li><a href="#" class="block text-[#e8720c]">Home</a></li>
        <li><a href="#about" class="block hover:text-[#e8720c]">About Us</a></li>
        <li><a href="#products" class="block hover:text-[#e8720c]">Products</a></li>
        <li><a href="#services" class="block hover:text-[#e8720c]">Services</a></li>
        <li><a href="#contact" class="block hover:text-[#e8720c]">Contact</a></li>
      </ul>
    </nav>
  </header>

  <!-- HERO -->
  <section
    class="relative min-h-[480px] flex items-center overflow-hidden bg-cover bg-center text-white sm:min-h-[520px]"
    style={`background-image: linear-gradient(90deg, rgba(0,0,0,0.97) 0%, rgba(0,0,0,0.86) 22%, rgba(0,0,0,0.52) 40%, rgba(0,0,0,0.18) 58%, rgba(0,0,0,0) 100%), url(${heroBackground.src});`}
  >
    <div class="absolute inset-0 bg-[#081b38]/20"></div>
    <div class="max-w-[560px] px-6 py-12 relative z-10 sm:pl-12 sm:pr-10 sm:py-15">
      <h1 class="text-4xl font-black leading-tight sm:text-5xl">
        Engineering<br /><span class="text-[#e8720c]">Machinery</span><br />Solutions
      </h1>
      <div class="text-xs font-semibold tracking-wider text-[#c9d6e8] mt-2 mb-4 sm:text-sm">
        BUILT FOR CAMBODIA'S INDUSTRY
      </div>
      <p class="text-xs text-[#c9d6e8] max-w-md mb-6 leading-relaxed sm:text-sm">
        We design, build, install and maintain high-quality industrial machinery to power your business and drive the future.
      </p>
      <div class="flex flex-wrap gap-3 sm:gap-4">
        <a href="#services" class="border-2 border-white px-3 py-3 text-[11px] font-bold text-white bg-white/5 hover:bg-white/15 rounded-xs transition sm:px-5 sm:text-xs">
          Our Services &rarr;
        </a>
        <a href="#products" class="bg-[#e8720c] hover:bg-[#c85f08] px-3 py-3 text-[11px] font-bold text-white rounded-xs transition sm:px-5 sm:text-xs">
          View Products &rarr;
        </a>
      </div>
    </div>
  </section>

  <FeatureStrip />

  <!-- PRODUCTS & SERVICES -->
<section class="bg-white py-12 px-4 sm:px-6 sm:py-16 lg:px-10" id="products">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-11">
        <h2 class="text-2xl font-black text-[#0d2a52] relative inline-block pb-3 sm:text-3xl after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-15 after:h-1 after:bg-[#e8720c]">
          Our Products & Services
        </h2>
        <p class="text-slate-500 text-xs mt-3 sm:text-sm">Reliable machinery and professional services for all industrial needs</p>
      </div>

      <div class="-mx-4 overflow-x-auto px-4 pb-3 sm:mx-0 sm:overflow-visible sm:px-0 sm:pb-0">
        <div class="grid w-max auto-cols-[minmax(150px,42vw)] grid-flow-col grid-rows-2 gap-4 sm:w-auto sm:auto-cols-auto sm:grid-flow-row sm:grid-cols-2 sm:grid-rows-none sm:gap-5 md:grid-cols-3 lg:grid-cols-5">
          {products.map((item) => (
            <ProductCard {...item} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <StatsBar />

  <!-- ABOUT + INDUSTRIES -->
  <section class="grid md:grid-cols-2 gap-10 py-12 px-4 bg-[#f4f6f8] sm:gap-12 sm:px-6 sm:py-16 lg:px-10" id="about">
    <div>
      <h3 class="text-xl font-black text-[#0d2a52] mb-4 sm:text-2xl">About D.TEC</h3>
      <p class="text-xs text-[#556173] mb-3 leading-relaxed sm:text-sm">
        Founded in 2019 in Phnom Penh City, Cambodia, D.TEC is a local engineering and machinery company committed to providing high-quality, reliable and cost-effective solutions for industrial businesses.
      </p>
      <p class="text-xs text-[#556173] mb-6 leading-relaxed sm:text-sm">
        We combine engineering expertise, modern technology and professional service to help our customers improve productivity, efficiency and workplace safety.
      </p>
      <a href="#" class="bg-[#0d2a52] hover:bg-[#081b38] text-white px-5 py-3 font-bold text-[11px] rounded-xs inline-block transition mb-5 sm:px-6 sm:text-xs">
        Read More About Us &rarr;
      </a>
      <div class="h-44 rounded bg-gradient-to-br from-[#d8dee5] to-[#e7ebef] flex items-center justify-center text-[#7a8794] text-[11px] font-mono sm:h-56 sm:text-xs">
        Photo: D.TEC Building / Office
      </div>
    </div>

    <div>
      <h3 class="text-xl font-black text-[#0d2a52] mb-6 relative pb-3 sm:text-2xl after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-12 after:h-1 after:bg-[#e8720c]">
        Industries We Serve
      </h3>
      
      <div class="flex flex-wrap gap-6 mb-8">
        {industries.map((ind) => (
          <div class="text-center w-20">
            <div class="w-13 h-13 rounded-full bg-white border border-[#dde3ea] flex items-center justify-center mx-auto mb-2 text-xl text-[#0d2a52]">
              {ind.icon}
            </div>
            <span class="text-[9px] text-[#647084] font-semibold uppercase tracking-wider block sm:text-[10px]">{ind.label}</span>
          </div>
        ))}
      </div>

      <div class="bg-[#0d2a52] text-white p-7 rounded relative overflow-hidden" id="services">
        <h4 class="text-base font-black mb-2 sm:text-lg">Let's Build the Future Together</h4>
        <p class="text-[11px] text-[#c9d6e8] mb-4 max-w-xs leading-relaxed sm:text-xs">
          We are ready to provide the best engineering and machinery solutions for your business.
        </p>
        <a href="#contact" class="bg-[#e8720c] hover:bg-[#c85f08] text-white px-4 py-3 font-bold text-[11px] rounded-xs inline-block transition sm:px-5 sm:text-xs">
          Contact Us Today &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-[#081b38] text-[#a8b6c6] pt-10 pb-5 px-4 sm:px-6 sm:pt-12 lg:px-10" id="contact">
    <div class="max-w-7xl mx-auto grid grid-cols-2 gap-x-5 gap-y-8 mb-8 text-[11px] sm:gap-10 sm:text-xs md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <div class="w-10 h-10 rounded-full bg-[#0d2a52] flex items-center justify-center text-white font-bold text-sm border-2 border-[#e8720c] mb-3">
          DT
        </div>
        <div class="text-white text-base font-black sm:text-lg">D.TEC</div>
        <p class="mt-2 leading-relaxed">Industrial Engineering Solutions<br />Built for Cambodia.</p>
      </div>

      <div>
        <h5 class="text-white font-bold text-sm mb-4">Quick Links</h5>
        <ul class="space-y-2">
          <li><a href="#" class="hover:text-[#e8720c]">Home</a></li>
          <li><a href="#about" class="hover:text-[#e8720c]">About Us</a></li>
          <li><a href="#products" class="hover:text-[#e8720c]">Products</a></li>
          <li><a href="#services" class="hover:text-[#e8720c]">Services</a></li>
          <li><a href="#contact" class="hover:text-[#e8720c]">Contact Us</a></li>
        </ul>
      </div>

      <div>
        <h5 class="text-white font-bold text-sm mb-4">Our Services</h5>
        <ul class="space-y-2">
          <li>Installation</li>
          <li>Maintenance & Repair</li>
          <li>Overhaul</li>
          <li>Spare Parts Support</li>
          <li>Steel Cutting Service</li>
        </ul>
      </div>

      <div class="col-span-2 md:col-span-1">
        <h5 class="text-white font-bold text-sm mb-4">Contact Us</h5>
        <div class="space-y-2 break-words">
          <p><span class="text-[#e8720c] mr-2">📍</span>Phnom Penh City, Cambodia</p>
          <p><span class="text-[#e8720c] mr-2">📞</span>+855 10 123 456</p>
          <p><span class="text-[#e8720c] mr-2">✉</span>info@dtec.com.kh</p>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto border-t border-white/10 pt-5 flex flex-col gap-2 text-[10px] leading-relaxed sm:flex-row sm:justify-between sm:text-[11px]">
      <span>© 2019 – 2026 D.TEC. All Rights Reserved.</span>
      <span>Designed & Developed by D.TEC Team</span>
    </div>
  </footer>

  <script>
    const menuButton = document.querySelector('#mobile-menu-button');
    const mobileMenu = document.querySelector('#mobile-menu');

    menuButton?.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
      mobileMenu?.classList.toggle('hidden', isOpen);
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Open navigation menu');
        mobileMenu.classList.add('hidden');
      });
    });
  </script>
</Layout>