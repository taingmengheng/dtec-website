---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import StatsBar from '../components/StatsBar.astro';
import heroBackground from '../assets/hero-background.png';
import products from '../data/products.json';

const industries = [
  { icon: "🏭", label: "Manufacturing" },
  { icon: "🔩", label: "Steel Fabrication" },
  { icon: "🏗", label: "Construction" },
  { icon: "🏬", label: "Warehouse & Logistics" },
  { icon: "🍾", label: "Food & Beverage" },
  { icon: "⋯", label: "And More" }
];
---

<Layout title="D.TEC | Engineering Machinery Services">
  <Navbar />

  <!-- HERO -->
  <section
    class="relative min-h-[480px] flex items-center overflow-hidden bg-cover bg-center text-white sm:min-h-[520px]"
    style={`background-image: linear-gradient(90deg, rgba(0,0,0,0.97) 0%, rgba(0,0,0,0.86) 22%, rgba(0,0,0,0.52) 40%, rgba(0,0,0,0.18) 58%, rgba(0,0,0,0) 100%), url(${heroBackground.src});`}
  >
    <div class="absolute inset-0 bg-dtec-navy/20"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-10">
    <div class="max-w-[560px] py-12 sm:py-15">
      <h1 class="text-4xl font-black leading-tight sm:text-5xl">
        Engineering<br /><span class="text-dtec-orange">Machinery</span><br />Solutions
      </h1>
      <div class="text-sm font-semibold tracking-wider text-[#c9d6e8] mt-2 mb-4 sm:text-base">
        BUILT FOR CAMBODIA'S INDUSTRY
      </div>
      <p class="text-sm text-[#c9d6e8] max-w-md mb-6 leading-relaxed sm:text-base">
        We design, build, install and maintain high-quality industrial machinery to power your business and drive the future.
      </p>
      <div class="flex flex-wrap gap-3 sm:gap-4">
        <a href="#services" class="border-2 border-white px-3 py-3 text-xs font-bold text-white bg-white/5 hover:bg-white/15 rounded-xs transition sm:px-5 sm:text-sm">
          Our Services &rarr;
        </a>
        <a href="#products" class="bg-dtec-orange hover:bg-dtec-orange-hover px-3 py-3 text-xs font-bold text-white rounded-xs transition sm:px-5 sm:text-sm">
          View Products &rarr;
        </a>
      </div>
    </div>
    </div>
  </section>

  <FeatureStrip />

  <!-- PRODUCTS & SERVICES -->
<section class="bg-white py-12 px-4 sm:px-6 sm:py-16 lg:px-10" id="products">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-11">
        <h2 class="text-2xl font-black text-dtec-blue relative inline-block pb-3 sm:text-3xl after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-15 after:h-1 after:bg-dtec-orange">
          Our Products & Services
        </h2>
        <p class="text-sm text-slate-500 mt-3 sm:text-base">Reliable machinery and professional services for all industrial needs</p>
      </div>

      <div class="-mx-4 overflow-x-auto px-4 pb-3 sm:mx-0 sm:overflow-visible sm:px-0 sm:pb-0">
        <div class="grid w-max auto-cols-[minmax(150px,42vw)] grid-flow-col grid-rows-2 gap-4 sm:w-full sm:auto-cols-auto sm:grid-flow-row sm:grid-cols-2 sm:grid-rows-none sm:gap-5 md:grid-cols-3 lg:grid-cols-5">
          {products.map((item) => (
            <ProductCard {...item} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <StatsBar />

  <!-- ABOUT + INDUSTRIES -->
  <section class="bg-[#f4f6f8] py-12 sm:py-16" id="about">
    <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 sm:gap-12 sm:px-6 md:grid-cols-2 lg:px-10">
    <div>
      <h3 class="text-xl font-black text-dtec-blue mb-4 sm:text-2xl">About D.TEC</h3>
      <p class="text-sm text-[#556173] mb-3 leading-relaxed sm:text-base">
        Founded in 2019 in Phnom Penh City, Cambodia, D.TEC is a local engineering and machinery company committed to providing high-quality, reliable and cost-effective solutions for industrial businesses.
      </p>
      <p class="text-sm text-[#556173] mb-6 leading-relaxed sm:text-base">
        We combine engineering expertise, modern technology and professional service to help our customers improve productivity, efficiency and workplace safety.
      </p>
      <a href="/contact/" class="bg-dtec-blue hover:bg-dtec-navy text-white px-5 py-3 font-bold text-xs rounded-xs inline-block transition mb-5 sm:px-6 sm:text-sm">
        Talk to Our Team &rarr;
      </a>
      <div class="h-44 rounded bg-gradient-to-br from-[#d8dee5] to-[#e7ebef] flex items-center justify-center text-[#7a8794] text-[11px] font-mono sm:h-56 sm:text-xs">
        Photo: D.TEC Building / Office
      </div>
    </div>

    <div>
      <h3 class="text-xl font-black text-dtec-blue mb-6 relative pb-3 sm:text-2xl after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-12 after:h-1 after:bg-dtec-orange">
        Industries We Serve
      </h3>
      
      <div class="flex flex-wrap gap-6 mb-8">
        {industries.map((ind) => (
          <div class="text-center w-20">
            <div class="w-13 h-13 rounded-full bg-white border border-[#dde3ea] flex items-center justify-center mx-auto mb-2 text-xl text-dtec-blue">
              {ind.icon}
            </div>
            <span class="text-xs text-[#647084] font-semibold uppercase tracking-wider block sm:text-sm">{ind.label}</span>
          </div>
        ))}
      </div>

      <div class="bg-dtec-blue text-white p-7 rounded relative overflow-hidden" id="services">
        <h4 class="text-base font-black mb-2 sm:text-lg">Let's Build the Future Together</h4>
        <p class="text-sm text-[#c9d6e8] mb-4 max-w-xs leading-relaxed sm:text-base">
          We are ready to provide the best engineering and machinery solutions for your business.
        </p>
        <a href="/contact/#quote" class="bg-dtec-orange hover:bg-dtec-orange-hover text-white px-4 py-3 font-bold text-xs rounded-xs inline-block transition sm:px-5 sm:text-sm">
          Contact Us Today &rarr;
        </a>
      </div>
    </div>
    </div>
  </section>

  <Footer />
</Layout>