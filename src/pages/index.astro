---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MachineryList from '../components/MachineryList.jsx';
---

<Layout title="D.TEC | Industrial Machinery & Engineering">
  <Navbar />

  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-100 tracking-tight">
        Precision Engineering & <span class="text-orange-500">Heavy Machinery</span>
      </h1>
      <p class="text-slate-400 mt-4 text-lg">
        Explore our workshop capabilities, equipment specifications, and past engineering work.
      </p>
      <a 
        href="https://t.me/YourTelegramUsername" 
        target="_blank" 
        class="inline-block mt-6 bg-orange-600 hover:bg-orange-500 text-white font-bold py-3 px-6 rounded-lg transition"
      >
        Inquire via Telegram
      </a>
    </div>

    <!-- Machinery Section with hydrated React component -->
    <div id="machinery" class="pt-8">
      <h2 class="text-2xl font-bold text-slate-100">Workshop Machinery & Capability</h2>
      <!-- client:load tells Astro to activate React JS for this component -->
      <MachineryList client:load />
    </div>
  </section>
</Layout>