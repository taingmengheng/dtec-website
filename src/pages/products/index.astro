---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
---

<Layout title="Products & Services | D.TEC" description="Explore D.TEC machinery, engineering products, and industrial services in Cambodia.">
  <Navbar />

  <main>
    <section class="bg-dtec-navy px-4 py-12 text-white sm:px-6 sm:py-16 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <a href="/" class="mb-5 inline-block text-sm font-semibold text-[#c9d6e8] hover:text-white">&larr; Home</a>
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-dtec-orange sm:text-sm">D.TEC Cambodia</p>
        <h1 class="text-3xl font-black sm:text-4xl">Products &amp; Services</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#c9d6e8] sm:text-base">
          Machinery, engineering solutions, and industrial services for businesses across Cambodia.
        </p>
      </div>
    </section>

    <section class="px-4 py-10 sm:px-6 sm:py-14 lg:px-10">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {products.map((product) => <ProductCard {...product} />)}
      </div>
    </section>
  </main>

  <Footer />
</Layout>