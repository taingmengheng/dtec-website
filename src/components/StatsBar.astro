---
const stats = [
  { icon: "🏆", num: "5+", label: "Years Experience", sub: "Since 2019" },
  { icon: "⚙", num: "100+", label: "Projects Completed", sub: "Across Cambodia" },
  { icon: "👥", num: "50+", label: "Happy Customers", sub: "Trusted by industries" },
  { icon: "🛡", num: "Safety", label: "Our Priority", sub: "Zero compromise" },
  { icon: "📍", num: "Cambodia", label: "Proudly Local", sub: "Supporting local industry" }
];
---

<div class="bg-[#081b38] px-10 py-8 flex flex-wrap justify-around gap-5">
  {stats.map((s) => (
    <div class="flex items-center gap-3.5 text-white min-w-[190px]">
      <div class="w-11 h-11 border-2 border-[#e8720c] rounded-full flex items-center justify-center text-[#e8720c] text-xl flex-shrink-0">
        {s.icon}
      </div>
      <div>
        <div class="text-xl font-black text-white">{s.num}</div>
        <div class="text-[11px] text-[#9fadbe] uppercase tracking-wider">{s.label}</div>
        <div class="text-[11px] text-[#7d8ca0]">{s.sub}</div>
      </div>
    </div>
  ))}
</div>