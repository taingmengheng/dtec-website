---
interface Props {
  id: string;
  title: string;
  desc: string;
  icon: string;
}

const { id, title, desc, icon } = Astro.props;
---

<a href={`/products/${id}/`} aria-label={`View ${title} details`} class="border border-[#e6e9ed] rounded bg-white overflow-hidden shadow-sm hover:shadow-lg transition flex flex-col justify-between group">
  <div>
    <div class="h-32 bg-gradient-to-br from-[#d8dee5] to-[#e7ebef] flex items-center justify-center text-[#7a8794] text-4xl sm:text-5xl" aria-hidden="true">
      {icon}
    </div>

    <div class="p-3 pt-6 relative sm:p-4 sm:pt-6">
      <div class="w-10 h-10 rounded-full bg-white border border-[#e2e6ea] flex items-center justify-center absolute -top-5 left-4 text-base text-dtec-orange shadow-md sm:text-lg">
        {icon}
      </div>

      <h4 class="font-bold text-sm text-dtec-blue mt-2 mb-1 sm:text-base">{title}</h4>
      <p class="text-xs text-[#7a8794] leading-relaxed whitespace-pre-line sm:text-sm">{desc}</p>
      <span class="mt-4 inline-flex items-center gap-2 text-xs font-bold text-dtec-orange sm:text-sm">View details <span aria-hidden="true">&rarr;</span></span>
    </div>
  </div>
</a>