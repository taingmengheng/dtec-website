---
// KeyCapabilities.astro
const features = [
  { icon: "⚙", title: "Engineering Excellence", desc: "Custom design & control systems" },
  { icon: "✓", title: "Safety & Reliability", desc: "Safety first in every solution we deliver" },
  { icon: "🤝", title: "Local Solutions & Support", desc: "Based in Cambodia, here when you need us" },
  { icon: "🔧", title: "Spare Parts & Service", desc: "Fast support & after-sales maintenance" }
];
---

<div class="bg-[#081b38] px-4 py-6 sm:px-10 sm:py-7">
  {/* Mobile: 2x2 Grid | Desktop: 4 Columns */}
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-6">
    {features.map((f) => (
      <div class="flex items-start gap-3 text-white">
        {/* Circle Icon Badge */}
        <div class="w-9 h-9 border-2 border-white/80 rounded-full flex-shrink-0 flex items-center justify-center text-white text-sm bg-white/5 sm:w-10 sm:h-10 sm:text-base">
          {f.icon}
        </div>

        {/* Text Content */}
        <div class="min-w-0 flex-1">
          <h4 class="text-xs font-bold text-white mb-0.5 leading-snug sm:text-xs">
            {f.title}
          </h4>
          
          {/* Strict 2-Line Clamp with Overflow Truncation */}
          <p class="text-[10px] text-[#a8b6c6] leading-snug line-clamp-2 overflow-hidden sm:text-[11px]">
            {f.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</div>